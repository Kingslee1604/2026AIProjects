# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.coverage
htmlcov/
dist/
build/

# Node
node_modules/
.next/
.pnpm-store/
*.tsbuildinfo
next-env.d.ts
test-results/
playwright-report/

# Downloaded datasets are never committed, in any project. Kept at the root (not only in each
# project's .gitignore) so the rule survives switching to a branch that lacks the project.
# Each project re-downloads its data with a script; small provenance manifests are kept.
**/data/raw/*
!**/data/raw/manifest.json

# Environment and secrets
.env
.env.*
!.env.example

# Personal Claude Code settings (shared .claude/settings.json may be committed)
.claude/settings.local.json

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Copied to .env by `make up` (scripts/ensure-env.sh), which generates the three passwords.
# .env is git-ignored and must never be committed.

# Database roles: schema owner (migrations), app (API + worker, RLS applies), run engine.
POSTGRES_PASSWORD=
AGENTFORGE_APP_DB_PASSWORD=
AGENTFORGE_ENGINE_DB_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000
AGENTFORGE_LOG_LEVEL=INFO

# Host-native Ollama (default). For the containerized one: http://ollama:11434 plus --profile ollama
AGENTFORGE_OLLAMA_BASE_URL=http://host.docker.internal:11434

# auto = real models (Ollama). fake = deterministic offline models: no Ollama needed, answers
# quote the top passage. CI browser tests use fake.
AGENTFORGE_MODEL_PROVIDER=auto

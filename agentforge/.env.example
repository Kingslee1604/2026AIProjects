# Copied to .env by `make up` (scripts/ensure-env.sh), which also generates POSTGRES_PASSWORD.
# .env is git-ignored and must never be committed.

POSTGRES_PASSWORD=
POSTGRES_PORT=5432
API_PORT=8000
AGENTFORGE_LOG_LEVEL=INFO

# Host-native Ollama (default). For the containerized one: http://ollama:11434 plus --profile ollama
AGENTFORGE_OLLAMA_BASE_URL=http://host.docker.internal:11434
